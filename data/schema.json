{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbanprobe.com/data/schema.json",
  "title": "UrbanProbe registry",
  "description": "Single source of truth for UrbanProbe resources. scripts/build.py generates the field lists on the site and the issue forms from this file; scripts/validate.py checks data/registry.json against it.",
  "x-site": {
    "name": "UrbanProbe",
    "url": "https://urbanprobe.com",
    "repo": "https://github.com/Hamsterradcc/urbanprobe.com",
    "standard": "standards.html",
    "pages_with_common": [
      "index.html",
      "standards.html"
    ],
    "artifacts": {
      "title": "Licence, access & citation",
      "description": "The licence of the release, any access conditions, what may not be redistributed, a version, and how to cite the resource.",
      "keys": [
        "version",
        "license",
        "access",
        "links",
        "citation"
      ]
    }
  },
  "x-common": [
    "geography_time",
    "provenance",
    "processing",
    "validation",
    "limitations"
  ],
  "x-registries": [
    {
      "key": "datasets",
      "number": "01",
      "label": "Datasets",
      "singular": "dataset",
      "card": "datasetCard",
      "page": "datasets.html",
      "template": "dataset-entry.yml",
      "artifacts": "Download or access route, format, version, licence, and citation.",
      "facets": [
        {
          "key": "themes",
          "label": "Theme"
        },
        {
          "key": "cities",
          "label": "Place"
        },
        {
          "key": "spatial_unit",
          "label": "Spatial unit"
        },
        {
          "key": "formats",
          "label": "Format"
        },
        {
          "key": "license",
          "label": "Licence"
        }
      ]
    },
    {
      "key": "indicators",
      "number": "02",
      "label": "Indicators",
      "singular": "indicator",
      "card": "indicatorCard",
      "page": "indicators.html",
      "template": "indicator-entry.yml",
      "artifacts": "Computed values, code, version, licence, and citation.",
      "facets": [
        {
          "key": "themes",
          "label": "Theme"
        },
        {
          "key": "cities",
          "label": "Place"
        },
        {
          "key": "spatial_unit",
          "label": "Spatial unit"
        }
      ]
    },
    {
      "key": "methods",
      "number": "03",
      "label": "Methods",
      "singular": "method",
      "card": "methodCard",
      "page": "methods.html",
      "template": "method-entry.yml",
      "artifacts": "Repository, release version, licence, and citation.",
      "facets": [
        {
          "key": "themes",
          "label": "Theme"
        },
        {
          "key": "formats",
          "label": "Language or format"
        },
        {
          "key": "license",
          "label": "Licence"
        }
      ]
    }
  ],
  "x-themes": [
    {
      "slug": "mobility",
      "label": "Mobility & Transportation"
    },
    {
      "slug": "built-environment",
      "label": "Built Environment & Land Use"
    },
    {
      "slug": "housing",
      "label": "Housing & Urban Economics"
    },
    {
      "slug": "climate",
      "label": "Climate, Energy & Resilience"
    },
    {
      "slug": "health-equity",
      "label": "Health, Equity & Accessibility"
    },
    {
      "slug": "sensing",
      "label": "Urban Sensing & Spatial Data"
    },
    {
      "slug": "governance",
      "label": "Governance & Participation"
    },
    {
      "slug": "urban-ai",
      "label": "Urban AI & Simulation"
    }
  ],
  "x-relations": {
    "evaluated-on": {
      "label": "Evaluated on",
      "inverse": "Evaluates"
    },
    "uses": {
      "label": "Uses",
      "inverse": "Used by"
    },
    "derived-from": {
      "label": "Derived from",
      "inverse": "Source for"
    },
    "computed-by": {
      "label": "Computed by",
      "inverse": "Computes"
    },
    "extends": {
      "label": "Extends",
      "inverse": "Extended by"
    },
    "related": {
      "label": "Related",
      "inverse": "Related"
    }
  },
  "type": "object",
  "required": [
    "datasets",
    "indicators",
    "methods"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/datasetEntry"
      }
    },
    "indicators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/indicatorEntry"
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/methodEntry"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug",
          "description": "Stable identifier, used in the resource URL."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 280,
          "description": "One sentence shown in the registry list."
        },
        "status": {
          "enum": [
            "draft",
            "released",
            "deprecated"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "released": {
          "$ref": "#/$defs/date"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "access": {
          "$ref": "#/$defs/text",
          "description": "Access conditions, and what may not be redistributed."
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "href"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/$defs/text"
              },
              "href": {
                "type": "string",
                "pattern": "^(https?://|[A-Za-z0-9._/-])"
              }
            }
          }
        },
        "citation": {
          "type": "string",
          "minLength": 10
        },
        "url": {
          "type": "string",
          "description": "Optional external card. When absent the resource is rendered by entry.html."
        },
        "replaced_by": {
          "$ref": "#/$defs/slug"
        },
        "themes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/theme"
          },
          "description": "Research themes shared across the network (City Computing Collective taxonomy)."
        },
        "cities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "Cities, regions, or countries covered or tested."
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.\\d{4,9}/\\S+$",
          "description": "DOI of the archived release, if any."
        },
        "usage": {
          "type": "string",
          "minLength": 1,
          "description": "A short snippet showing how to load or run the artifact."
        },
        "changelog": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "version",
              "date",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "note": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "registry",
              "id",
              "relation"
            ],
            "additionalProperties": false,
            "properties": {
              "site": {
                "enum": [
                  "xurbanai",
                  "urbanprobe"
                ],
                "description": "Omit for this site."
              },
              "registry": {
                "type": "string"
              },
              "id": {
                "$ref": "#/$defs/slug"
              },
              "relation": {
                "enum": [
                  "evaluated-on",
                  "uses",
                  "derived-from",
                  "computed-by",
                  "extends",
                  "related"
                ]
              }
            }
          }
        },
        "spatial_unit": {
          "$ref": "#/$defs/text",
          "description": "Unit of the data, used as a filter (e.g. census tract, street segment, 100 m grid)."
        },
        "period": {
          "type": "string",
          "pattern": "^\\d{4}(–\\d{4})?$",
          "description": "Year or year range, e.g. 2015–2024."
        },
        "formats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CSV",
              "Parquet",
              "GeoJSON",
              "GeoParquet",
              "GeoPackage",
              "Shapefile",
              "GeoTIFF",
              "JSON",
              "NetCDF",
              "Python",
              "R",
              "Notebook"
            ]
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "date",
                  "geometry",
                  "category"
                ]
              },
              "unit": {
                "type": "string"
              },
              "description": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "preview": {
          "type": "string",
          "pattern": "^(https://|[A-Za-z0-9._/-]+\\.csv$)",
          "description": "A small CSV sample (≤ 1 MB) shown as a table with column statistics."
        },
        "distributions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "format",
              "href"
            ],
            "additionalProperties": false,
            "properties": {
              "format": {
                "type": "string"
              },
              "href": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "size": {
                "type": "string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "released"
              }
            }
          },
          "then": {
            "required": [
              "version",
              "released",
              "authors",
              "license",
              "links",
              "citation",
              "card"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "deprecated"
              }
            }
          },
          "then": {
            "required": [
              "version",
              "released"
            ]
          }
        }
      ]
    },
    "datasetEntry": {
      "$ref": "#/$defs/entry",
      "properties": {
        "card": {
          "$ref": "#/$defs/datasetCard"
        }
      },
      "unevaluatedProperties": false
    },
    "indicatorEntry": {
      "$ref": "#/$defs/entry",
      "properties": {
        "card": {
          "$ref": "#/$defs/indicatorCard"
        }
      },
      "unevaluatedProperties": false
    },
    "methodEntry": {
      "$ref": "#/$defs/entry",
      "properties": {
        "card": {
          "$ref": "#/$defs/methodCard"
        }
      },
      "unevaluatedProperties": false
    },
    "geography_time": {
      "$ref": "#/$defs/text",
      "title": "Geography & time",
      "description": "Spatial extent, spatial unit or resolution, time span, and update cadence."
    },
    "provenance": {
      "$ref": "#/$defs/text",
      "title": "Provenance",
      "description": "Original sources, how they were obtained, and the rights attached to them."
    },
    "processing": {
      "$ref": "#/$defs/text",
      "title": "Processing",
      "description": "Every step between the source and the released resource, with the code that performs it."
    },
    "validation": {
      "$ref": "#/$defs/text",
      "title": "Validation",
      "description": "How the resource was checked, against what, and the results of those checks."
    },
    "limitations": {
      "$ref": "#/$defs/text",
      "title": "Limitations",
      "description": "Known gaps, biases, and misuse risks."
    },
    "datasetCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geography_time": {
          "$ref": "#/$defs/geography_time",
          "title": "Coverage & time",
          "description": "Extent, spatial unit or raster resolution, coordinate reference system, period covered, observation dates, and update cadence."
        },
        "variables_schema": {
          "$ref": "#/$defs/text",
          "title": "Variables & schema",
          "description": "Every field with its type, unit, allowed values, and missing-value convention."
        },
        "provenance": {
          "$ref": "#/$defs/provenance",
          "title": "Source & collection",
          "description": "Original providers, collection method, sampling, and the rights attached to each source."
        },
        "processing": {
          "$ref": "#/$defs/processing",
          "description": "Cleaning, joining, aggregation, and derivation steps, with the code that performs them."
        },
        "validation": {
          "$ref": "#/$defs/validation",
          "title": "Validation & quality",
          "description": "Completeness, consistency checks, comparison with reference data, and known error rates."
        },
        "limitations": {
          "$ref": "#/$defs/limitations",
          "description": "Coverage gaps, biases, temporal mismatches, and uses the dataset does not support."
        }
      }
    },
    "indicatorCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/text",
          "title": "Definition & rationale",
          "description": "What the indicator is meant to measure, the concept behind it, and why this operationalisation."
        },
        "provenance": {
          "$ref": "#/$defs/provenance",
          "title": "Inputs",
          "description": "The datasets it is computed from, with versions, and any parameters or thresholds used."
        },
        "processing": {
          "$ref": "#/$defs/processing",
          "title": "Computation",
          "description": "The formula or algorithm, step by step, with the code that implements it."
        },
        "spatial_scale": {
          "$ref": "#/$defs/text",
          "title": "Spatial unit & scale",
          "description": "The unit the indicator is reported at, and how it behaves when aggregated or disaggregated."
        },
        "geography_time": {
          "$ref": "#/$defs/geography_time",
          "title": "Coverage & time",
          "description": "Places and periods for which values are released."
        },
        "validation": {
          "$ref": "#/$defs/validation",
          "description": "Agreement with ground truth, surveys, or established measures, and the results of those comparisons."
        },
        "sensitivity": {
          "$ref": "#/$defs/text",
          "title": "Sensitivity & uncertainty",
          "description": "How the indicator responds to parameter choices and input errors, and how uncertainty is reported."
        },
        "limitations": {
          "$ref": "#/$defs/limitations",
          "title": "Limitations & misuse",
          "description": "Contexts where the indicator is not valid, and interpretations it does not support."
        }
      }
    },
    "methodCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "problem_users": {
          "$ref": "#/$defs/text",
          "title": "Problem & intended users",
          "description": "The urban question the method answers and who is expected to run it."
        },
        "inputs_outputs": {
          "$ref": "#/$defs/text",
          "title": "Inputs & outputs",
          "description": "Required inputs with formats and sources, and the outputs produced with their schema."
        },
        "provenance": {
          "$ref": "#/$defs/provenance",
          "title": "Data sources",
          "description": "Data the method was developed and tested on, and the rights attached to it."
        },
        "processing": {
          "$ref": "#/$defs/processing",
          "title": "Steps & dependencies",
          "description": "The pipeline in order, with software dependencies and their versions."
        },
        "installation_runtime": {
          "$ref": "#/$defs/text",
          "title": "Installation & runtime",
          "description": "How to set up the environment, expected run time, and hardware requirements."
        },
        "example": {
          "$ref": "#/$defs/text",
          "title": "Example & test data",
          "description": "A worked example with small test data that reproduces a published result."
        },
        "geography_time": {
          "$ref": "#/$defs/geography_time",
          "title": "Tested geography",
          "description": "Places and periods where the method has been applied and checked."
        },
        "validation": {
          "$ref": "#/$defs/validation",
          "description": "How outputs were checked, including comparison with alternative methods where they exist."
        },
        "maintenance": {
          "$ref": "#/$defs/text",
          "title": "Maintenance status",
          "description": "Whether the method is maintained, who maintains it, and known open issues."
        },
        "limitations": {
          "$ref": "#/$defs/limitations"
        }
      }
    },
    "theme": {
      "enum": [
        "mobility",
        "built-environment",
        "housing",
        "climate",
        "health-equity",
        "sensing",
        "governance",
        "urban-ai"
      ]
    }
  }
}
